font-family = "IosevkaTerm Nerd Font"
font-family-italic = "IosevkaTerm Nerd Font Italic"
font-family-bold = "IosevkaTerm Nerd Font Bold"
font-family-bold-italic = "IosevkaTerm Nerd Font Bold Italic"
font-size = 16

window-width=120
window-height=33

theme = Catppuccin Mocha

# Gamma-correct the blend so text doesn't render thin/dark over transparency.
alpha-blending = linear-corrected

background-blur = macos-glass-regular
background-opacity = 0.85

unfocused-split-opacity = 0.60

macos-titlebar-style="hidden"


